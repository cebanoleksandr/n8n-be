PORT=3000
DATABASE_URL=postgres://flow:flow@localhost:5440/flow
# Apply pending migrations on startup
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
REDIS_URL=redis://localhost:6390
# all = API + worker in one process (dev); in production run `api` and `worker` separately
APP_ROLE=all
WORKER_CONCURRENCY=5
# Encrypts stored credentials. Generate: openssl rand -base64 32
# Losing or changing it makes existing credentials unreadable.
ENCRYPTION_KEY=
# Upper bound for a single execution; workflows may set a lower timeout
EXECUTION_TIMEOUT_MAX_SECONDS=3600
# Finished executions (and their files) older than this are deleted hourly; 0 = keep
EXECUTIONS_MAX_AGE_DAYS=14
# Binary data (S3-compatible; SeaweedFS from docker-compose locally). The bucket is created on startup.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=flow-binary-data
S3_ACCESS_KEY=flow
S3_SECRET_KEY=flow-secret
S3_FORCE_PATH_STYLE=true
# Largest file accepted by webhooks and stored by nodes
BINARY_MAX_BYTES=52428800
# Signs access tokens. Generate: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Behind a reverse proxy: true, hop count, or subnets (e.g. loopback,10.0.0.0/8)
TRUST_PROXY=false
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
